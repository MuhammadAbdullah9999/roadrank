---
import { site as cfg } from '../site.config';
import '../styles.css';
import '../theme.css';
const { title, description = cfg.description, type = 'website' } = Astro.props;
const fullTitle = title === cfg.name ? `${cfg.name}: ${cfg.tagline}` : `${title} | ${cfg.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(cfg.ogImage, Astro.site);
const path = Astro.url.pathname;
const links = [['Features', '/#features'], ['How it works', '/#how'], ['Blog', '/blog'], ['FAQ', '/faq'], ['About', '/about']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={cfg.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    {(cfg as any).googleVerification && <meta name="google-site-verification" content={(cfg as any).googleVerification} />}
    {(cfg as any).fontHref && <link rel="stylesheet" href={(cfg as any).fontHref} />}
    <link rel="alternate" type="application/rss+xml" title={`${cfg.name} blog`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={cfg.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/"><img src="/icon.png" alt="" width="34" height="34" />{cfg.name}</a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
      <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
      <nav class="menu">
        {links.map(([t, h]) => <a href={h} class:list={[{ on: h === path || (h === '/blog' && path.startsWith('/blog')) }]}>{t}</a>)}
        {cfg.storeUrl
          ? <a class="btn small" href={cfg.storeUrl}>Get the app</a>
          : <a class="btn small soon" href="/#notify">Coming soon</a>}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-grid">
        <div>
          <a class="brand" href="/"><img src="/icon.png" alt="" width="30" height="30" />{cfg.name}</a>
          <p>{cfg.footer}</p>
          <p class="small-print">{cfg.disclaimer}</p>
        </div>
        <div><h4>Explore</h4><a href="/#features">Features</a><a href="/#how">How it works</a><a href="/blog">Blog</a><a href="/faq">FAQ</a><a href="/about">About</a></div>
        <div><h4>Legal</h4><a href="/privacy.html">Privacy policy</a><a href="/terms.html">Terms of use</a>{cfg.deleteUrl && <a href={cfg.deleteUrl}>Delete account</a>}<a href={`mailto:${cfg.email}`}>Contact</a></div>
        <div><h4>More apps</h4><a href={cfg.sister.url}>{cfg.sister.name}</a><a href="/rss.xml">RSS feed</a><a href="/sitemap-index.xml">Sitemap</a></div>
      </div>
      <p class="copy">© {new Date().getFullYear()} {cfg.name}. All rights reserved.</p>
    </footer>
    <div id="progress"></div>
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var sel = '.section>h2,.section>.eyebrow,.section>.lead,.stats,.card,.row,.pro-box,.steps li,.strip,.faq details,.tile,.head-row,.final>*,.about-body>*,.prose>*,.feature,.foot-grid>div';
        var els = document.querySelectorAll(sel);
        els.forEach(function (el) {
          var sib = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          el.style.setProperty('--i', Math.min(sib, 6));
          el.classList.add('rv');
        });
        function count(el) {
          var m = /^(\D*)(\d+)(.*)$/.exec(el.textContent.trim());
          if (!m || rm) return;
          var end = +m[2], t0 = performance.now(), dur = 1100;
          (function step(t) {
            var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
            el.textContent = m[1] + Math.round(end * e) + m[3];
            if (p < 1) requestAnimationFrame(step);
          })(t0);
        }
        var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            if (e.target.classList.contains('stats')) e.target.querySelectorAll('strong').forEach(count);
            io.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }) : null;
        els.forEach(function (el) { io ? io.observe(el) : el.classList.add('in'); });
        var bar = document.getElementById('progress'), nav = document.querySelector('.nav'), tick = false;
        function upd() {
          var h = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = 'scaleX(' + (h > 0 ? scrollY / h : 0) + ')';
          nav.classList.toggle('stuck', scrollY > 8);
          tick = false;
        }
        addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
        upd();
      })();
    </script>
  </body>
</html>
